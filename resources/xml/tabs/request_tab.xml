<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingLeft="@style/main/content_padding_sides"
    paddingRight="@style/main/content_padding_sides"
    paddingTop="@style/main/content_padding_top_bottom"
    paddingBottom="@style/main/content_padding_top_bottom">

    <brls:Box
        axis="row"
        alignItems="center"
        marginBottom="16">

        <brls:InputCell
            id="request/search/input"
            title="Search Media"
            grow="1.0"
            marginRight="12" />

        <brls:DetailCell
            id="request/search/filter"
            title="Type"
            width="170"
            marginRight="12" />

        <brls:DetailCell
            id="request/search/settings"
            title="Settings"
            width="200" />
    </brls:Box>

    <brls:Label
        id="request/status/label"
        fontSize="14"
        textColor="@theme/font/grey"
        marginBottom="12"
        visibility="gone" />

    <!-- poster grid: wraps into rows (a plain row Box does not wrap) -->
    <RecyclingGrid
        id="request/grid"
        grow="1"
        wireframe="false"
        spanCount="@style/app/grid/6"
        itemHeight="@style/app/video/height" />

</brls:Box>
