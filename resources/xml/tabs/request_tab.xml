<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingLeft="@style/main/content_padding_sides"
    paddingRight="@style/main/content_padding_sides"
    paddingTop="@style/main/content_padding_top_bottom"
    paddingBottom="@style/main/content_padding_top_bottom">

    <brls:Box
        axis="row"
        alignItems="center"
        marginBottom="16">

        <brls:InputCell
            id="request/search/input"
            title="Search Media"
            hint="Type movie or TV name..."
            grow="1.0"
            marginRight="12" />

        <brls:DetailCell
            id="request/search/filter"
            title="Type"
            detail="All"
            width="140"
            marginRight="12" />

        <brls:DetailCell
            id="request/search/settings"
            title="Settings"
            detail="Radarr/Sonarr"
            width="160" />
    </brls:Box>

    <brls:Label
        id="request/status/label"
        fontSize="14"
        textColor="@theme/font/grey"
        marginBottom="12"
        text="Enter a title above to search Radarr &amp; Sonarr" />

    <brls:ScrollingFrame
        id="request/scroll"
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            id="request/grid/container"
            width="100%"
            height="auto"
            axis="row"
            direction="leftToRight"
            alignItems="flexStart"
            justifyContent="flexStart">
        </brls:Box>
    </brls:ScrollingFrame>

</brls:Box>
