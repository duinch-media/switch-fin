<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            height="auto"
            axis="column"
            paddingLeft="@style/main/content_padding_sides"
            paddingRight="@style/main/content_padding_sides"
            paddingTop="@style/main/content_padding_top_bottom"
            paddingBottom="@style/main/content_padding_top_bottom">

            <SearchList
                id="search/movie"
                title="@i18n/main/search/genres/movie"
                height="350"
                itemType="Movie"
                pageSize="16" />

            <SearchList
                id="search/series"
                title="@i18n/main/search/genres/series"
                height="350"
                itemType="Series"
                pageSize="16" />

            <!-- Radarr/Sonarr: titles not in the library yet, requestable -->
            <ArrSearchList
                id="search/radarr"
                title="@i18n/main/search/genres/request_movie"
                height="350"
                service="radarr" />

            <ArrSearchList
                id="search/sonarr"
                title="@i18n/main/search/genres/request_series"
                height="350"
                service="sonarr" />

            <SearchList
                id="search/episode"
                title="@i18n/main/search/genres/episode"
                height="350"
                itemType="Episode"
                pageSize="16" />

            <SearchList
                id="search/music"
                title="@i18n/main/search/genres/music"
                height="260"
                itemType="MusicAlbum"
                pageSize="16" />
        </brls:Box>

    </brls:ScrollingFrame>

    <ButtonClose
        positionType="absolute"
        positionTop="2"
        positionRight="2" />

</brls:Box>