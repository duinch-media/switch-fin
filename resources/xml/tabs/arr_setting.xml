<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            paddingLeft="@style/main/content_padding_sides"
            paddingRight="@style/main/content_padding_sides"
            paddingTop="@style/main/content_padding_top_bottom"
            paddingBottom="@style/main/content_padding_top_bottom">

            <brls:Header
                title="Radarr (Movies)" />

            <brls:InputCell
                id="setting/radarr/url"
                title="Server URL" />

            <brls:InputCell
                id="setting/radarr/key"
                title="API Key" />

            <brls:InputCell
                id="setting/radarr/root"
                title="Root Folder" />

            <brls:DetailCell
                id="setting/radarr/test"
                title="Test Connection" />

            <brls:DetailCell
                id="setting/radarr/scan"
                title="Scan LAN for Radarr" />

            <brls:Header
                marginTop="20"
                title="Sonarr (TV Series)" />

            <brls:InputCell
                id="setting/sonarr/url"
                title="Server URL" />

            <brls:InputCell
                id="setting/sonarr/key"
                title="API Key" />

            <brls:InputCell
                id="setting/sonarr/root"
                title="Root Folder" />

            <brls:DetailCell
                id="setting/sonarr/test"
                title="Test Connection" />

            <brls:DetailCell
                id="setting/sonarr/scan"
                title="Scan LAN for Sonarr" />

        </brls:Box>
    </brls:ScrollingFrame>

    <ButtonClose
        positionType="absolute"
        positionTop="2"
        positionRight="2" />

</brls:Box>
