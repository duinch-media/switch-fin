<brls:Box
    highlightCornerRadius="8"
    axis="column"
    width="160"
    height="280"
    margin="6">
    <brls:Box
        axis="column"
        grow="1"
        positionType="relative">
        <brls:Image
            id="request/card/poster"
            backgroundColor="@theme/color/grey_1"
            width="100%"
            height="220"
            scalingType="fill"
            cornerRadius="6" />

        <brls:Box
            positionType="absolute"
            positionTop="6"
            positionLeft="6"
            backgroundColor="#D9000000"
            cornerRadius="4"
            paddingTop="2"
            paddingBottom="2"
            paddingLeft="6"
            paddingRight="6">
            <brls:Label
                id="request/card/type"
                fontSize="12"
                textColor="#FFFFFF" />
        </brls:Box>

        <brls:Box
            positionType="absolute"
            positionBottom="6"
            positionRight="6"
            backgroundColor="#D9000000"
            cornerRadius="4"
            paddingTop="2"
            paddingBottom="2"
            paddingLeft="6"
            paddingRight="6">
            <brls:Label
                id="request/card/status"
                fontSize="12"
                textColor="#FFFFFF" />
        </brls:Box>
    </brls:Box>

    <brls:Label
        id="request/card/title"
        fontSize="14"
        lines="2"
        marginTop="4"
        textColor="@theme/font/align" />

    <brls:Label
        id="request/card/year"
        fontSize="12"
        textColor="@theme/font/grey" />
</brls:Box>
